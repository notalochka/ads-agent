# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Agent limits
AGENT_MAX_ITERATIONS=3
AGENT_MIN_ADS=3
AGENT_MAX_ADS=30
AGENT_REQUEST_TIMEOUT_MS=120000

# Data source mode: mock | apify
ADS_SOURCE=mock

# Apify (required when ADS_SOURCE=apify)
# Create a token at https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_ACTOR_ID=apify/facebook-ads-scraper
# How long to wait for Actor run completion (seconds)
APIFY_WAIT_SECS=120

# LLM provider: gemini | mock
LLM_PROVIDER=mock
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated fallbacks if primary is unavailable / rate-limited
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-2.0-flash
# Ads per Gemini request (keeps prompts small)
GEMINI_BATCH_SIZE=5

# CORS (comma-separated origins for production)
CORS_ORIGIN=http://localhost:5173

# Frontend (client): API base URL
# VITE_API_BASE=http://localhost:3000

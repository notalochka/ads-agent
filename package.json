{
  "name": "ads-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AdsRadar (ads-agent) – competitor ads intelligence agent for digital/affiliate marketing",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "tsc -p tsconfig.json",
    "build:client": "npm run build --prefix client",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --prefix client",
    "check:creds": "tsx scripts/check-creds.ts",
    "smoke:apify": "tsx scripts/smoke-apify.ts",
    "smoke:gemini": "tsx scripts/smoke-gemini.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "apify-client": "^2.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
